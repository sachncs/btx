---
const principles = [
  {
    title: 'Air-gappable by default',
    body: 'Network I/O is opt-in and isolated. The core library imports cleanly in fully offline environments — perfect for forensic and hardware workflows.',
  },
  {
    title: 'Deterministic, auditable code',
    body: 'Strict type hints, mypy in strict-ish mode, and 99%+ test coverage across the curve, encoding, and signature layers.',
  },
  {
    title: 'No silent behaviour',
    body: 'Every helper is a documented public symbol — re-exported from the package root. No _foo chase, no surprises.',
  },
];
---

<section id="security" class="relative py-24 sm:py-32">
  <div class="container-page">
    <div class="grid items-stretch gap-6 lg:grid-cols-2">
      <div class="reveal">
        <span class="eyebrow">Security posture</span>
        <h2 class="mt-3 text-display-lg font-semibold text-balance">
          Cryptography deserves <br />
          <span class="text-gradient-accent">cryptography-grade rigor.</span>
        </h2>
        <p class="mt-5 max-w-md text-pretty text-ink-300">
          btx is built for environments where correctness is not
          optional. Each layer is testable in isolation, each helper
          has a public name, and there are no surprises buried in
          private modules.
        </p>

        <div class="mt-8 space-y-5">
          {principles.map((p, i) => (
            <div class="reveal flex gap-4" data-delay={i * 80}>
              <div class="relative flex h-6 w-6 shrink-0 items-center justify-center">
                <span class="absolute inset-0 animate-pulse-ring rounded-full bg-accent-500/30"></span>
                <span class="relative h-2 w-2 rounded-full bg-accent-500"></span>
              </div>
              <div>
                <h3 class="text-base font-semibold text-white">{p.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-300">{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal" data-delay="160">
        <div class="relative h-full overflow-hidden rounded-3xl border border-white/[0.07] bg-gradient-to-br from-ink-900/80 to-ink-950/80 p-8 shadow-soft">
          <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent-500/10 blur-3xl"></div>
          <div class="absolute -left-10 bottom-0 h-48 w-48 rounded-full bg-accent-500/5 blur-3xl"></div>

          <div class="relative flex h-full flex-col">
            <div class="flex items-center justify-between">
              <span class="eyebrow">Reference implementation</span>
              <span class="font-mono text-[11px] text-ink-400">SEC-2 v2.0</span>
            </div>

            <div class="mt-8 space-y-4 font-mono text-[12px] text-ink-300">
              <div class="rounded-xl border border-white/[0.06] bg-ink-950/80 p-4">
                <div class="text-[10px] uppercase tracking-[0.18em] text-ink-500">Curve</div>
                <div class="mt-1.5 text-accent-300">y² = x³ + 7 (mod p)</div>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-ink-950/80 p-4">
                <div class="text-[10px] uppercase tracking-[0.18em] text-ink-500">Prime</div>
                <div class="mt-1.5 break-all text-accent-300">p = 2²⁵⁶ − 2³² − 977</div>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-ink-950/80 p-4">
                <div class="text-[10px] uppercase tracking-[0.18em] text-ink-500">Order</div>
                <div class="mt-1.5 break-all text-accent-300">n = 0xFFFFFFFF…FFFFFECD</div>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-ink-950/80 p-4">
                <div class="text-[10px] uppercase tracking-[0.18em] text-ink-500">Generator G</div>
                <div class="mt-1.5 break-all text-accent-300">Gx = 0x79BE…02A7F3</div>
                <div class="mt-0.5 break-all text-accent-300">Gy = 0x483A…D916CA</div>
              </div>
            </div>

            <div class="mt-auto pt-6">
              <div class="flex items-center justify-between border-t border-white/[0.06] pt-4">
                <span class="text-xs text-ink-400">Conforms to SEC-2 v2.0</span>
                <a
                  href="https://www.secg.org/sec2-v2.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs text-accent-400 hover:text-accent-300"
                >
                  View spec
                  <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>