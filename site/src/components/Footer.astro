---
const cols = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '#features' },
      { label: 'Architecture', href: '#architecture' },
      { label: 'Security', href: '#security' },
      { label: 'Use cases', href: '#use-cases' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Documentation', href: 'https://sachncs.github.io/btx-docs' },
      { label: 'PyPI', href: 'https://pypi.org/project/btx/' },
      { label: 'API reference', href: 'https://github.com/sachncs/btx#api' },
      { label: 'Changelog', href: 'https://github.com/sachncs/btx/blob/master/CHANGELOG.md' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: 'https://github.com/sachncs/btx' },
      { label: 'Issues', href: 'https://github.com/sachncs/btx/issues' },
      { label: 'Discussions', href: 'https://github.com/sachncs/btx/discussions' },
      { label: 'Roadmap', href: 'https://github.com/sachncs/btx#roadmap' },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Contributing', href: 'https://github.com/sachncs/btx/blob/master/CONTRIBUTING.md' },
      { label: 'Code of conduct', href: 'https://github.com/sachncs/btx/blob/master/CODE_OF_CONDUCT.md' },
      { label: 'Security policy', href: 'https://github.com/sachncs/btx/blob/master/SECURITY.md' },
      { label: 'License (MIT)', href: 'https://github.com/sachncs/btx/blob/master/LICENSE' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/[0.06] bg-ink-950">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-accent-500 to-accent-700 shadow-glow">
            <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-ink-950" aria-hidden="true">
              <path d="M3 13c2-3 4-3 6 0s4 3 6 0 4-3 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M3 17c2-3 4-3 6 0s4 3 6 0 4-3 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
            </svg>
          </span>
          <span class="text-[15px] font-semibold tracking-tight text-white">btx</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ink-400">
          A pure-Python toolkit for parsing, signing and analysing Bitcoin
          transactions on the secp256k1 curve. Crafted with care, layered
          for clarity.
        </p>

        <div class="mt-6 flex items-center gap-2">
          <a
            href="https://github.com/sachncs/btx"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-ink-300 transition-colors hover:bg-white/[0.06] hover:text-white"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 008 10.94c.59.11.8-.25.8-.56v-2c-3.26.7-3.95-1.4-3.95-1.4-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.6-.3-5.34-1.3-5.34-5.78 0-1.28.46-2.32 1.2-3.14-.12-.3-.52-1.49.11-3.1 0 0 .98-.31 3.21 1.2a11.2 11.2 0 015.86 0c2.23-1.51 3.21-1.2 3.21-1.2.63 1.61.23 2.8.11 3.1.74.82 1.2 1.86 1.2 3.14 0 4.49-2.74 5.47-5.36 5.77.42.36.8 1.06.8 2.13v3.16c0 .31.21.67.81.55A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
          </a>
          <a
            href="https://pypi.org/project/btx/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-ink-300 transition-colors hover:bg-white/[0.06] hover:text-white"
            aria-label="PyPI"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M12 1.6c-1.4 0-2.7.05-3.95.15C5.6 2.05 4.2 3.45 3.9 5.85c-.25 1.95-.25 4-.25 6s0 4.05.25 6c.3 2.4 1.7 3.8 4.15 4.1C9.3 22.05 10.6 22.4 12 22.4s2.7-.05 3.95-.15c2.45-.3 3.85-1.7 4.15-4.1.25-1.95.25-4 .25-6s0-4.05-.25-6c-.3-2.4-1.7-3.8-4.15-4.1C14.7 1.65 13.4 1.6 12 1.6zM11 11.95V20l-1.4-.1c-1.65-.1-2.55-.95-2.7-2.55-.15-1.55-.15-3.4-.15-5.35s0-3.8.15-5.35C7.05 5.05 7.95 4.2 9.6 4.1L11 4v8zM19.95 8.55c0 1.95 0 3.8-.15 5.35-.15 1.6-1.05 2.45-2.7 2.55L16 16.4v-4l1.4-1.4-1.4-1.4V4l1.1.1c1.65.1 2.55.95 2.7 2.55.15 1.55.15 3.4.15 1.9z"/>
            </svg>
          </a>
        </div>
      </div>

      {cols.map((col) => (
        <div>
          <h4 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-ink-400">
            {col.title}
          </h4>
          <ul class="mt-4 space-y-3">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-ink-300 transition-colors hover:text-white"
                  {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/[0.06] pt-8 sm:flex-row sm:items-center">
      <div class="flex items-center gap-3 text-xs text-ink-500">
        <span>© {year} btx contributors.</span>
        <span class="hidden sm:inline-block">·</span>
        <span>Released under the MIT License.</span>
      </div>
      <div class="flex items-center gap-2 font-mono text-[11px] text-ink-500">
        <span class="flex h-1.5 w-1.5 rounded-full bg-accent-500 shadow-[0_0_8px_rgba(95,208,164,0.6)]"></span>
        <span>Built with Astro · Tailwind · Pure Python underneath</span>
      </div>
    </div>
  </div>
</footer>