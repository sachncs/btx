---
const base = import.meta.env.BASE_URL;
const cols = [
  { title: 'Explore', links: [{ label: 'Capabilities', href: `${base}#capabilities` }, { label: 'Architecture', href: `${base}#architecture` }, { label: 'Reliability', href: `${base}#reliability` }, { label: 'Install', href: `${base}#install` }] },
  { title: 'Docs', links: [{ label: 'Getting started', href: `${base}/docs/getting-started` }, { label: 'API reference', href: `${base}/docs/api` }, { label: 'Architecture', href: `${base}/docs/architecture` }, { label: 'Testing', href: `${base}/docs/testing` }, { label: 'Changelog', href: `${base}/docs/changelog` }] },
  { title: 'Project', links: [{ label: 'GitHub', href: 'https://github.com/sachncs/btx' }, { label: 'Issues', href: 'https://github.com/sachncs/btx/issues' }, { label: 'Contributing', href: `${base}/docs/contributing` }, { label: 'Security', href: `${base}/docs/security` }] },
];
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/[0.06] bg-ink-950">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_repeat(3,1fr)]">
      <div class="max-w-sm">
        <a href={base} class="inline-flex items-center gap-2.5" aria-label="btx home">
          <img src={`${base}/btx-logo.svg`} alt="" class="h-7 w-7 rounded-lg shadow-glow" width="28" height="28" />
          <span class="text-[15px] font-semibold tracking-tight text-white">btx</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ink-400">A source-first Python toolkit for parsing, signing, and analysing Bitcoin transactions on secp256k1.</p>
        <a href="https://github.com/sachncs/btx/issues" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-ink-300 transition-colors hover:bg-white/[0.06] hover:text-white">Report an issue</a>
      </div>
      {cols.map((col) => (
        <div>
          <h4 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-ink-400">{col.title}</h4>
          <ul class="mt-4 space-y-3">
            {col.links.map((link) => <li><a href={link.href} class="text-sm text-ink-300 transition-colors hover:text-white" {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/[0.06] pt-8 text-xs text-ink-500 sm:flex-row sm:items-center">
      <span>© {year} btx contributors · MIT License</span>
      <span class="font-mono">Static site · source-first distribution</span>
    </div>
  </div>
</footer>
