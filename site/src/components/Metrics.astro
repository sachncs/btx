---
const metrics = [
  { value: '886',     label: 'Tests passing',    sub: 'pytest + Hypothesis' },
  { value: '99%',     label: 'Test coverage',    sub: 'across the core stack' },
  { value: '0',       label: 'Runtime deps',     sub: 'Typer is the only one' },
  { value: '3.41ms',  label: 'Per-curve-op',     sub: 'native backend · median' },
];

const standards = [
  { code: 'BIP-141', desc: 'Segregated Witness' },
  { code: 'BIP-143', desc: 'SegWit v0 sighash' },
  { code: 'BIP-174', desc: 'PSBT format' },
  { code: 'BIP-340', desc: 'Schnorr signatures' },
  { code: 'BIP-341', desc: 'Taproot' },
  { code: 'RFC-6979', desc: 'Deterministic ECDSA' },
];
---

<section class="relative py-24 sm:py-32">
  <div class="container-page">
    <div class="reveal">
      <div class="relative overflow-hidden rounded-3xl border border-white/[0.07] bg-ink-900/40 p-8 sm:p-12">
        <div class="absolute inset-0 -z-10 opacity-[0.4]">
          <div class="absolute inset-0 bg-grid-faint bg-grid-lg mask-fade-b"></div>
        </div>
        <div class="absolute -top-32 left-1/2 h-[400px] w-[800px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(95,208,164,0.12),transparent_70%)] blur-3xl"></div>

        <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.4fr]">
          <div>
            <span class="eyebrow">By the numbers</span>
            <h2 class="mt-3 text-display-lg font-semibold text-balance">
              Built with the same care <br />
              you bring to your code.
            </h2>
            <p class="mt-4 text-pretty text-ink-300">
              Public benchmarks on every push. 99%+ coverage across
              the public API. A clean slate for your most demanding
              Bitcoin workloads.
            </p>
          </div>

          <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.07]">
            {metrics.map((m) => (
              <div class="bg-ink-950/80 p-6 transition-colors hover:bg-ink-900/80">
                <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-400">{m.label}</dt>
                <dd class="mt-2 font-display text-3xl font-semibold text-white sm:text-4xl">
                  {m.value}
                </dd>
                <p class="mt-1 font-mono text-[11px] text-ink-500">{m.sub}</p>
              </div>
            ))}
          </dl>
        </div>

        <div class="mt-12 border-t border-white/[0.06] pt-10">
          <p class="eyebrow">Standards implemented</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {standards.map((s) => (
              <div class="group flex items-center gap-2 rounded-full border border-white/[0.07] bg-white/[0.02] px-3 py-1.5 transition-colors hover:bg-white/[0.05]">
                <span class="font-mono text-xs font-medium text-accent-400">{s.code}</span>
                <span class="text-xs text-ink-400">·</span>
                <span class="text-xs text-ink-300">{s.desc}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>