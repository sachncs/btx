---
const guarantees = [
  { label: 'Compatibility', value: 'Python 3.12–3.14', body: 'The supported interpreter range is declared in the package metadata and exercised in CI.' },
  { label: 'Runtime boundary', value: 'Typer + stdlib core', body: 'The CLI uses Typer; parsing and curve code stay free of network clients.' },
  { label: 'Optional speed', value: 'coincurve backend', body: 'Install the optional extra when native libsecp256k1 throughput is appropriate.' },
  { label: 'Standards', value: 'BIP-aware', body: 'Transaction, sighash, PSBT, Schnorr, and Taproot paths follow documented Bitcoin standards.' },
];

const standards = [
  { code: 'BIP-141', desc: 'Segregated Witness' },
  { code: 'BIP-143', desc: 'SegWit v0 sighash' },
  { code: 'BIP-174', desc: 'PSBT format' },
  { code: 'BIP-340', desc: 'Schnorr signatures' },
  { code: 'BIP-341', desc: 'Taproot' },
  { code: 'RFC-6979', desc: 'Deterministic ECDSA' },
];
---

<section id="reliability" class="relative py-24 sm:py-32">
  <div class="container-page">
    <div class="reveal overflow-hidden rounded-3xl border border-white/[0.07] bg-ink-900/50 p-6 sm:p-10">
      <div class="grid items-start gap-10 lg:grid-cols-[0.75fr_1.25fr]">
        <div>
          <span class="eyebrow">Reliability contract</span>
          <h2 class="mt-3 text-display-lg font-semibold text-balance">Know what runs where.</h2>
          <p class="mt-4 max-w-md text-pretty text-ink-300">The project keeps deterministic parsing and cryptographic primitives separate from network services, optional acceleration, and development tooling.</p>
        </div>
        <div class="grid gap-px overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.07] sm:grid-cols-2">
          {guarantees.map((item) => (
            <div class="bg-ink-950/90 p-5 transition-colors hover:bg-ink-900/90">
              <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-400">{item.label}</p>
              <h3 class="mt-2 text-lg font-semibold text-white">{item.value}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-400">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-10 border-t border-white/[0.06] pt-8">
        <p class="eyebrow">Standards represented in the codebase</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {standards.map((standard) => <span class="pill"><span class="font-mono text-accent-400">{standard.code}</span><span class="text-ink-500">·</span>{standard.desc}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
