---
const proof = [
  { label: 'Protocol-aware', value: 'BIP-141 · 143 · 174 · 340 · 341' },
  { label: 'Runtime boundary', value: 'Core parsing stays offline-safe' },
  { label: 'Public surface', value: 'CLI + Python API + source docs' },
];
---

<section class="relative border-y border-white/[0.07] bg-white/[0.018]">
  <div class="container-page grid gap-0 divide-y divide-white/[0.07] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
    {proof.map((item, index) => (
      <div class={`flex items-center justify-between gap-4 py-5 sm:block sm:px-6 ${index === 0 ? 'sm:pl-0' : ''} ${index === proof.length - 1 ? 'sm:pr-0' : ''}`}>
        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-500">{item.label}</span>
        <span class="text-right text-xs text-ink-200 sm:mt-2 sm:block sm:text-left">{item.value}</span>
      </div>
    ))}
  </div>
</section>
