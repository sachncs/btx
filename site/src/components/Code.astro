---
const tabs = [
  {
    id: 'extract',
    label: 'Extract',
    code: `<span class="text-ink-400">$</span> <span class="text-white">btx extract</span> <span class="text-accent-400">0200000001...</span>
<span class="text-accent-300">txid</span>     <span class="text-ink-500">=</span> <span class="text-accent-100">9f2c…8e44</span>
<span class="text-accent-300">inputs</span>   <span class="text-ink-500">=</span> <span class="text-accent-100">2</span>
<span class="text-accent-300">sigs</span>     <span class="text-ink-500">=</span> <span class="text-accent-100">2</span>
<span class="text-accent-300">verified</span> <span class="text-ink-500">=</span> <span class="text-accent-500">true</span>
  <span class="text-ink-500">[0]</span> <span class="text-accent-300">P2WPKH</span>  r=<span class="text-accent-100">c8b3…4a2f</span>  s=<span class="text-accent-100">1d6e…92bc</span>
  <span class="text-ink-500">[1]</span> <span class="text-accent-300">P2TR</span>    <span class="text-accent-400">taproot key-path</span>  z=<span class="text-accent-100">7a91…05d3</span>`,
  },
  {
    id: 'api',
    label: 'Python API',
    code: `<span class="text-ink-500"># parse, extract, verify — three lines.</span>
<span class="text-ink-300">from</span> btx <span class="text-ink-300">import</span> parse_tx, extract_signatures, verify_signature

tx, _ = <span class="text-ink-400">parse_tx</span>(<span class="text-accent-400">bytes.fromhex</span>(raw_hex))
records = <span class="text-ink-400">extract_signatures</span>(tx)

<span class="text-ink-300">for</span> rec <span class="text-ink-300">in</span> records:
    ok = <span class="text-ink-400">verify_signature</span>(rec.z, rec.signature, rec.public_key)
    <span class="text-ink-400">print</span>(rec.txid, rec.input_index, ok)`,
  },
  {
    id: 'attack',
    label: 'Nonce reuse',
    code: `<span class="text-ink-500"># detect & recover from ECDSA nonce reuse</span>
<span class="text-ink-300">from</span> btx.signature.attack <span class="text-ink-300">import</span> (
    detect_nonce_reuse, recover_from_nonce_reuse,
)

groups = <span class="text-ink-400">detect_nonce_reuse</span>(collection)

<span class="text-ink-300">for</span> g <span class="text-ink-300">in</span> groups:
    result = <span class="text-ink-400">recover_from_nonce_reuse</span>(
        collection.records[g.indices[<span class="text-accent-100">0</span>]],
        collection.records[g.indices[<span class="text-accent-100">1</span>]],
    )
    <span class="text-ink-400">print</span>(<span class="text-accent-100">"private_key ="</span>, result.private_key)`,
  },
  {
    id: 'psbt',
    label: 'PSBT',
    code: `<span class="text-ink-500"># BIP-174 round-trip — parse, edit, serialize</span>
<span class="text-ink-300">from</span> btx <span class="text-ink-300">import</span> parse_psbt, serialize_psbt, PsbtEditor

psbt = <span class="text-ink-400">parse_psbt</span>(raw_bytes)

<span class="text-ink-300">with</span> <span class="text-ink-400">PsbtEditor</span>(psbt) <span class="text-ink-300">as</span> ed:
    ed.set_input(<span class="text-accent-100">0</span>, sighash=<span class="text-accent-100">0x01</span>)
    ed.add_signature(<span class="text-accent-100">0</span>, der_sig, pubkey)

out = <span class="text-ink-400">serialize_psbt</span>(ed.finalize())`,
  },
];
---

<section id="code" class="relative py-24 sm:py-32">
  <div class="container-page">
    <div class="grid items-end gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div class="reveal">
        <span class="eyebrow">In your hands</span>
        <h2 class="mt-3 text-display-lg font-semibold text-balance">
          One library, <br />
          <span class="text-gradient-accent">the entire surface.</span>
        </h2>
        <p class="mt-5 max-w-md text-pretty text-ink-300">
          From a 60-character CLI to a deeply programmable Python API.
          Same precision underneath, no half-implemented corners.
        </p>

        <ul class="mt-8 space-y-3 text-sm text-ink-300">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-accent-500/30 bg-accent-500/10 text-[10px] text-accent-400">✓</span>
            <span><span class="font-medium text-white">Deterministic</span> parsing — no hidden state, no global caches.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-accent-500/30 bg-accent-500/10 text-[10px] text-accent-400">✓</span>
            <span><span class="font-medium text-white">Frozen dataclasses</span> with slots — value semantics out of the box.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-accent-500/30 bg-accent-500/10 text-[10px] text-accent-400">✓</span>
            <span><span class="font-medium text-white">All-public API</span> — no chasing <code class="kbd">_foo</code> through submodules.</span>
          </li>
        </ul>
      </div>

      <div class="reveal" data-delay="120">
        <div class="code-block noise">
          <div
            class="flex items-center gap-1 overflow-x-auto border-b border-white/[0.06] bg-white/[0.02] px-2 py-1.5"
            role="tablist"
            aria-label="Code examples"
          >
            {tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-tab={t.id}
                class={`tab-btn ${i === 0 ? 'is-active' : ''} shrink-0 rounded-md px-3 py-1.5 font-mono text-[11px] tracking-tight text-ink-400 transition-colors hover:text-ink-200`}
              >
                {t.label}
              </button>
            ))}
            <div class="ml-auto flex items-center gap-1.5 pr-2">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]/80"></span>
            </div>
          </div>

          <div class="relative">
            {tabs.map((t, i) => (
              <pre
                role="tabpanel"
                data-panel={t.id}
                class={`overflow-x-auto p-5 ${i === 0 ? '' : 'hidden'}`}
              ><code set:html={t.code}></code></pre>
            ))}
            <div class="pointer-events-none absolute bottom-3 right-3 flex items-center gap-1.5 rounded-md border border-white/[0.06] bg-white/[0.03] px-2 py-0.5 font-mono text-[10px] text-ink-400 backdrop-blur">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-500"></span>
              python · btx
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('[role="tablist"]').forEach((list) => {
      const buttons = list.querySelectorAll('[role="tab"]');
      const root = list.parentElement;
      if (!root) return;
      const panels = root.parentElement.querySelectorAll('[data-panel]');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');
          buttons.forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-selected', active ? 'true' : 'false');
            b.classList.toggle('is-active', active);
            b.classList.toggle('bg-white/[0.05]', active);
            b.classList.toggle('text-white', active);
          });
          panels.forEach((p) => {
            p.classList.toggle('hidden', p.getAttribute('data-panel') !== target);
          });
        });
      });
    });
  </script>
</section>