---
const cases = [
  {
    title: 'Forensic analysis',
    body: 'Parse blocks, extract every signature, and search for nonce reuse across millions of transactions — all in pure Python.',
    badge: 'Security',
  },
  {
    title: 'Wallet engineering',
    body: 'Construct, sign and broadcast transactions with immutable value semantics and a fully public, predictable API.',
    badge: 'Wallets',
  },
  {
    title: 'Research & education',
    body: 'Read the byte-level wire format with code that mirrors the BIPs. Ideal for teaching secp256k1 from the ground up.',
    badge: 'Research',
  },
  {
    title: 'Compliance tooling',
    body: 'Batch-process PSBTs, classify scripts, and verify signatures deterministically — without touching the network.',
    badge: 'Compliance',
  },
];
---

<section id="use-cases" class="relative py-24 sm:py-32">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">Where teams use it</span>
      <h2 class="mt-3 text-display-lg font-semibold text-balance">
        One library. <span class="text-gradient-accent">Many surfaces.</span>
      </h2>
      <p class="mt-4 text-pretty text-ink-300">
        From incident response to wallet R&D — btx fits in wherever
        Bitcoin primitives need to be reasoned about, not just called.
      </p>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {cases.map((c, i) => (
        <div
          class="card reveal group"
          data-spotlight
          data-delay={i * 80}
        >
          <div class="flex items-center justify-between">
            <span class="rounded-md border border-white/10 bg-white/[0.04] px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.16em] text-ink-300">
              {c.badge}
            </span>
            <span class="text-ink-500 transition-colors group-hover:text-accent-400 group-hover:translate-x-0.5">
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
          <h3 class="mt-6 text-lg font-semibold tracking-tight text-white">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-300">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>