---
const links = [
  { href: '#features', label: 'Features' },
  { href: '#code', label: 'Code' },
  { href: '#architecture', label: 'Architecture' },
  { href: '#security', label: 'Security' },
];
---

<header
  class="sticky top-0 z-40 border-b border-white/[0.06] bg-ink-950/70 backdrop-blur-xl supports-[backdrop-filter]:bg-ink-950/60"
>
  <div class="container-page flex h-14 items-center justify-between">
    <a href="/" class="group flex shrink-0 items-center gap-2.5">
      <span class="relative flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-accent-500 to-accent-700 shadow-glow">
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-ink-950" aria-hidden="true">
          <path d="M3 13c2-3 4-3 6 0s4 3 6 0 4-3 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M3 17c2-3 4-3 6 0s4 3 6 0 4-3 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
        </svg>
      </span>
      <span class="text-[15px] font-semibold tracking-tight text-white">btx</span>
      <span class="hidden rounded-md border border-white/10 bg-white/[0.03] px-1.5 py-0.5 font-mono text-[10px] text-ink-300 lg:inline-block">v1.0</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="rounded-full px-3 py-1.5 text-sm text-ink-300 transition-colors hover:bg-white/[0.04] hover:text-white"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/sachncs/btx"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-ink-200 transition-colors hover:bg-white/[0.06] hover:text-white lg:inline-flex"
        aria-label="Star on GitHub"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 008 10.94c.59.11.8-.25.8-.56v-2c-3.26.7-3.95-1.4-3.95-1.4-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.6-.3-5.34-1.3-5.34-5.78 0-1.28.46-2.32 1.2-3.14-.12-.3-.52-1.49.11-3.1 0 0 .98-.31 3.21 1.2a11.2 11.2 0 015.86 0c2.23-1.51 3.21-1.2 3.21-1.2.63 1.61.23 2.8.11 3.1.74.82 1.2 1.86 1.2 3.14 0 4.49-2.74 5.47-5.36 5.77.42.36.8 1.06.8 2.13v3.16c0 .31.21.67.81.55A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
        </svg>
        <span>Star</span>
        <span class="font-mono text-xs text-ink-300">★</span>
      </a>
      <a
        href="https://pypi.org/project/btx/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary !px-3 !py-1.5 text-xs sm:!text-sm sm:!px-5 sm:!py-2.5"
      >
        <span class="hidden sm:inline">pip install btx</span>
        <span class="sm:hidden">Install</span>
      </a>
    </div>
  </div>
</header>