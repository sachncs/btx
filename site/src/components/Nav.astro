---
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}/docs`, label: 'Docs' },
  { href: `${base}#capabilities`, label: 'Capabilities' },
  { href: `${base}#code`, label: 'Quick start' },
  { href: `${base}#architecture`, label: 'Architecture' },
  { href: `${base}#reliability`, label: 'Reliability' },
];
---

<header class="sticky top-0 z-40 border-b border-white/[0.06] bg-ink-950/85 backdrop-blur-xl">
  <div class="container-page flex min-h-14 items-center justify-between gap-4 py-2">
    <a href={base} class="group flex shrink-0 items-center gap-2.5" aria-label="btx home">
      <img src={`${base}/btx-logo.svg`} alt="" class="h-7 w-7 rounded-lg shadow-glow" width="28" height="28" />
      <span class="text-[15px] font-semibold tracking-tight text-white">btx</span>
      <span class="hidden rounded-md border border-white/10 bg-white/[0.03] px-1.5 py-0.5 font-mono text-[10px] text-ink-300 lg:inline-block">source</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((link) => <a href={link.href} class="rounded-full px-3 py-1.5 text-sm text-ink-300 transition-colors hover:bg-white/[0.04] hover:text-white">{link.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <a href="https://github.com/sachncs/btx" target="_blank" rel="noopener noreferrer" class="hidden rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-ink-200 transition-colors hover:bg-white/[0.06] hover:text-white sm:inline-flex">GitHub</a>
      <a href={`${base}#install`} class="btn-primary !px-3 !py-1.5 text-xs sm:!px-4 sm:!py-2 sm:!text-sm">Install from source</a>
    </div>
  </div>
</header>
