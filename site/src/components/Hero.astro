---
const base = import.meta.env.BASE_URL;
const facts = [
  { value: '3.12+', label: 'Supported Python' },
  { value: 'CLI', label: 'and Python API' },
  { value: 'Offline', label: 'core by default' },
  { value: 'MIT', label: 'licensed' },
];
---

<section class="relative isolate overflow-hidden pb-20 pt-16 sm:pb-28 sm:pt-24 lg:pb-32 lg:pt-28">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-grid-faint bg-grid-md mask-fade-b opacity-[0.55]"></div>
    <div class="absolute left-1/2 top-[-18%] h-[720px] w-[1000px] max-w-none -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(95,208,164,0.16),transparent_70%)] blur-3xl"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-500/50 to-transparent"></div>
  </div>

  <div class="container-page">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <div class="reveal"><span class="pill"><span class="pill-dot"></span> Source-first · secp256k1 · Python 3.12+</span></div>
        <h1 class="reveal mt-6 max-w-3xl text-display-2xl font-semibold text-balance" data-delay="80">
          <span class="text-gradient">Understand Bitcoin</span><br />
          <span class="text-gradient-accent">at the byte level.</span>
        </h1>
        <p class="reveal mt-6 max-w-xl text-pretty text-lg leading-relaxed text-ink-300 sm:text-xl" data-delay="160">
          btx is a pure-Python toolkit for parsing transactions, extracting ECDSA and Schnorr signatures, working with PSBTs, and reasoning about secp256k1.
        </p>
        <div class="reveal mt-8 flex flex-col items-start gap-3 sm:flex-row" data-delay="240">
          <a href={`${base}#install`} class="btn-accent">Install from source <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/sachncs/btx" target="_blank" rel="noopener noreferrer" class="btn-ghost">Read the source</a>
        </div>
        <div class="reveal mt-4 flex flex-wrap items-center gap-3 text-xs text-ink-400" data-delay="300">
          <code class="kbd">git clone …</code>
          <span>PyPI publication is not enabled yet.</span>
        </div>
      </div>

      <div class="reveal" data-delay="140">
        <div class="code-block noise shadow-card">
          <div class="flex items-center justify-between border-b border-white/[0.06] bg-white/[0.02] px-4 py-3">
            <span class="font-mono text-[11px] text-ink-400">quick start</span>
            <span class="rounded-full border border-accent-500/20 bg-accent-500/10 px-2 py-0.5 font-mono text-[10px] text-accent-300">source</span>
          </div>
          <pre class="!p-5 text-[12px] leading-loose sm:text-[13px]"><code><span class="text-ink-500">$</span> <span class="text-white">git clone</span> <span class="text-accent-300">https://github.com/sachncs/btx.git</span>
<span class="text-ink-500">$</span> <span class="text-white">cd</span> btx
<span class="text-ink-500">$</span> <span class="text-white">python -m venv</span> .venv
<span class="text-ink-500">$</span> <span class="text-white">.venv/bin/python -m pip install -e</span> .
<span class="text-ink-500">$</span> <span class="text-white">.venv/bin/btx health</span>
<span class="text-accent-400">✓</span> <span class="text-ink-200">backend: native</span>
<span class="text-accent-400">✓</span> <span class="text-ink-200">core imports: offline-safe</span></code></pre>
          <div class="border-t border-white/[0.06] px-5 py-3 text-xs text-ink-400">Development: <code class="text-ink-200">python -m pip install -e ".[dev]"</code></div>
        </div>
      </div>
    </div>

    <dl class="reveal mt-16 grid grid-cols-2 gap-4 border-y border-white/[0.07] py-6 sm:mt-20 sm:grid-cols-4 sm:gap-0" data-delay="340">
      {facts.map((fact, index) => (
        <div class={`px-2 ${index > 0 ? 'sm:border-l sm:border-white/[0.07] sm:pl-6' : ''}`}>
          <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">{fact.label}</dt>
          <dd class="mt-2 text-lg font-semibold text-white sm:text-xl">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
