---
import Layout from '~/layouts/Layout.astro';
import Nav from '~/components/Nav.astro';
import Hero from '~/components/Hero.astro';
import Features from '~/components/Features.astro';
import Code from '~/components/Code.astro';
import Architecture from '~/components/Architecture.astro';
import Security from '~/components/Security.astro';
import Metrics from '~/components/Metrics.astro';
import UseCases from '~/components/UseCases.astro';
import CTA from '~/components/CTA.astro';
import Footer from '~/components/Footer.astro';
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />
    <div class="divider-gradient mx-auto max-w-5xl"></div>
    <Features />
    <Code />
    <Architecture />
    <Security />
    <Metrics />
    <UseCases />
    <CTA />
  </main>
  <Footer />
</Layout>